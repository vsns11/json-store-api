# Copy to .env for docker compose. Never commit real credentials.
APP_VERSION=dev

DB_NAME=jsonstore
DB_USER=jsonstore
DB_PASSWORD=change-me
# Change if you already run PostgreSQL on 5432.
DB_PORT=5432

API_PORT=8080
WEB_ORIGIN=http://localhost:3000

# Local directory for sign-in. Point LDAP_URL at your corporate LDAP instead to use real accounts.
LDAP_PORT=389
LDAP_ADMIN_PASSWORD=admin

# Must be at least 32 characters. Generate one per environment.
JWT_SECRET=change-me-to-a-long-random-string-please
