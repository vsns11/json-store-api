# Test directory for the in-process LDAP server used outside production.
# alice is in admins and developers, bob in developers, dave in auditors, and carol in no group at all.
# The local profile maps admins, developers and auditors to ADMIN, EDITOR and VIEWER, so carol is refused.
dn: dc=example,dc=com
objectclass: top
objectclass: domain
dc: example

dn: ou=people,dc=example,dc=com
objectclass: top
objectclass: organizationalUnit
ou: people

dn: uid=alice,ou=people,dc=example,dc=com
objectclass: top
objectclass: person
objectclass: organizationalPerson
objectclass: inetOrgPerson
cn: Alice Nguyen
sn: Nguyen
uid: alice
mail: alice@example.com
userPassword: secret

dn: uid=bob,ou=people,dc=example,dc=com
objectclass: top
objectclass: person
objectclass: organizationalPerson
objectclass: inetOrgPerson
cn: Bob Patel
sn: Patel
uid: bob
mail: bob@example.com
userPassword: secret

dn: uid=carol,ou=people,dc=example,dc=com
objectclass: top
objectclass: person
objectclass: organizationalPerson
objectclass: inetOrgPerson
cn: Carol Okafor
sn: Okafor
uid: carol
mail: carol@example.com
userPassword: secret

dn: uid=dave,ou=people,dc=example,dc=com
objectclass: top
objectclass: person
objectclass: organizationalPerson
objectclass: inetOrgPerson
cn: Dave Lindqvist
sn: Lindqvist
uid: dave
mail: dave@example.com
userPassword: secret

dn: ou=groups,dc=example,dc=com
objectclass: top
objectclass: organizationalUnit
ou: groups

dn: cn=developers,ou=groups,dc=example,dc=com
objectclass: top
objectclass: groupOfNames
cn: developers
member: uid=alice,ou=people,dc=example,dc=com
member: uid=bob,ou=people,dc=example,dc=com

dn: cn=admins,ou=groups,dc=example,dc=com
objectclass: top
objectclass: groupOfNames
cn: admins
member: uid=alice,ou=people,dc=example,dc=com

dn: cn=auditors,ou=groups,dc=example,dc=com
objectclass: top
objectclass: groupOfNames
cn: auditors
member: uid=dave,ou=people,dc=example,dc=com
