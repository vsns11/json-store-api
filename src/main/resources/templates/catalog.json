{
  "version": 2,
  "documents": [
    {
      "id": "orders-api",
      "label": "Orders API",
      "description": "The request the shop's API receives"
    },
    {
      "id": "payments",
      "label": "Payments",
      "description": "What the payment provider is asked to do"
    },
    {
      "id": "inventory",
      "label": "Inventory",
      "description": "Stock reservations for the order"
    },
    {
      "id": "kafka-events",
      "label": "Kafka events",
      "description": "The event published on the bus"
    },
    {
      "id": "notifications",
      "label": "Notifications",
      "description": "Messages the customer should receive"
    },
    {
      "id": "assertions",
      "label": "Assertions",
      "description": "What the run is expected to produce"
    }
  ],
  "groups": [
    {
      "id": "scenario",
      "label": "Scenario",
      "required": true,
      "help": "What the test is exercising"
    },
    {
      "id": "customer",
      "label": "Customer"
    },
    {
      "id": "payment",
      "label": "Payment"
    },
    {
      "id": "fulfilment",
      "label": "Fulfilment"
    },
    {
      "id": "notification",
      "label": "Notifications"
    },
    {
      "id": "expectations",
      "label": "Expected outcome"
    }
  ],
  "fragments": [
    {
      "id": "checkout",
      "group": "scenario",
      "name": "Checkout",
      "description": "One basket taken through to payment",
      "fields": [
        {
          "key": "scenarioName",
          "label": "Scenario name",
          "type": "text",
          "default": "Checkout \u2014 happy path",
          "required": true
        },
        {
          "key": "environment",
          "label": "Environment",
          "type": "radio",
          "options": [
            "local",
            "dev",
            "staging",
            "prod-mirror"
          ],
          "default": "staging"
        },
        {
          "key": "orderRef",
          "label": "Order reference",
          "type": "text",
          "default": "ORD-10042"
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "select",
          "options": [
            "EUR",
            "GBP",
            "USD",
            "INR"
          ],
          "default": "EUR"
        },
        {
          "key": "sku",
          "label": "Item SKU",
          "type": "text",
          "default": "NEST-01"
        },
        {
          "key": "quantity",
          "label": "Quantity",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 99
        },
        {
          "key": "unitPriceMinor",
          "label": "Unit price",
          "type": "number",
          "default": 4999,
          "help": "In minor units, so 4999 is \u20ac49.99"
        },
        {
          "key": "featureFlags",
          "label": "Feature flags on",
          "type": "checkboxes",
          "options": [
            "express-pay",
            "one-click",
            "new-basket"
          ],
          "default": [
            "express-pay"
          ]
        }
      ],
      "documents": {
        "orders-api": {
          "method": "POST",
          "path": "/v2/orders",
          "body": {
            "reference": "${orderRef}",
            "environment": "${environment}",
            "featureFlags": "${featureFlags}",
            "currency": "${currency}",
            "lines": [
              {
                "sku": "${sku}",
                "quantity": "${quantity}",
                "unitPriceMinor": "${unitPriceMinor}"
              }
            ]
          }
        },
        "kafka-events": {
          "topic": "orders.events",
          "key": "${orderRef}",
          "value": {
            "type": "order.created",
            "reference": "${orderRef}",
            "currency": "${currency}"
          }
        },
        "assertions": {
          "scenario": "${scenarioName}",
          "order": {
            "reference": "${orderRef}",
            "lines": 1
          }
        }
      }
    },
    {
      "id": "bulk-import",
      "group": "scenario",
      "name": "Bulk import",
      "description": "A file pushed through the importer",
      "fields": [
        {
          "key": "scenarioName",
          "label": "Scenario name",
          "type": "text",
          "default": "Bulk import \u2014 10k rows",
          "required": true
        },
        {
          "key": "environment",
          "label": "Environment",
          "type": "radio",
          "options": [
            "local",
            "dev",
            "staging",
            "prod-mirror"
          ],
          "default": "staging"
        },
        {
          "key": "sourceKey",
          "label": "Source file",
          "type": "text",
          "default": "2026-09-01/orders.csv"
        },
        {
          "key": "rows",
          "label": "Rows",
          "type": "number",
          "default": 10000,
          "min": 1
        },
        {
          "key": "batchSize",
          "label": "Batch size",
          "type": "range",
          "default": 500,
          "min": 100,
          "max": 2000,
          "step": 100
        },
        {
          "key": "stopOnError",
          "label": "Stop on first error",
          "type": "switch",
          "default": false
        }
      ],
      "documents": {
        "orders-api": {
          "method": "POST",
          "path": "/v2/orders/import",
          "body": {
            "environment": "${environment}",
            "source": {
              "bucket": "acme-imports",
              "key": "${sourceKey}"
            },
            "batch": {
              "rows": "${rows}",
              "size": "${batchSize}",
              "stopOnError": "${stopOnError}"
            }
          }
        },
        "kafka-events": {
          "topic": "imports.events",
          "key": "${sourceKey}",
          "value": {
            "type": "import.started",
            "rows": "${rows}"
          }
        },
        "assertions": {
          "scenario": "${scenarioName}",
          "import": {
            "rows": "${rows}"
          }
        }
      }
    },
    {
      "id": "subscription-renewal",
      "group": "scenario",
      "name": "Subscription renewal",
      "description": "A renewal charged on its due date",
      "fields": [
        {
          "key": "scenarioName",
          "label": "Scenario name",
          "type": "text",
          "default": "Renewal \u2014 card on file",
          "required": true
        },
        {
          "key": "environment",
          "label": "Environment",
          "type": "radio",
          "options": [
            "local",
            "dev",
            "staging",
            "prod-mirror"
          ],
          "default": "staging"
        },
        {
          "key": "planCode",
          "label": "Plan",
          "type": "select",
          "options": [
            {
              "value": "PRO-MONTHLY",
              "label": "Pro, monthly"
            },
            {
              "value": "PRO-YEARLY",
              "label": "Pro, yearly"
            },
            {
              "value": "TEAM-YEARLY",
              "label": "Team, yearly"
            }
          ],
          "default": "PRO-MONTHLY"
        },
        {
          "key": "renewalDate",
          "label": "Renewal date",
          "type": "date",
          "default": "2026-10-01"
        },
        {
          "key": "autoRenew",
          "label": "Auto-renew",
          "type": "switch",
          "default": true
        }
      ],
      "documents": {
        "orders-api": {
          "method": "POST",
          "path": "/v2/subscriptions/renew",
          "body": {
            "environment": "${environment}",
            "plan": "${planCode}",
            "renewsOn": "${renewalDate}",
            "autoRenew": "${autoRenew}"
          }
        },
        "kafka-events": {
          "topic": "billing.events",
          "key": "${planCode}",
          "value": {
            "type": "subscription.renewal.due",
            "renewsOn": "${renewalDate}"
          }
        },
        "assertions": {
          "scenario": "${scenarioName}",
          "subscription": {
            "plan": "${planCode}"
          }
        }
      }
    },
    {
      "id": "returning-customer",
      "group": "customer",
      "name": "Returning customer",
      "description": "An account with order history",
      "fields": [
        {
          "key": "customerId",
          "label": "Customer id",
          "type": "text",
          "default": "cus_1042"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "text",
          "default": "ada@example.com"
        },
        {
          "key": "country",
          "label": "Country",
          "type": "select",
          "options": [
            "NL",
            "GB",
            "DE",
            "US",
            "IN"
          ],
          "default": "NL"
        },
        {
          "key": "loyaltyTier",
          "label": "Loyalty tier",
          "type": "radio",
          "options": [
            "none",
            "silver",
            "gold"
          ],
          "default": "gold"
        }
      ],
      "documents": {
        "orders-api": {
          "body": {
            "customer": {
              "type": "returning",
              "id": "${customerId}",
              "country": "${country}",
              "loyaltyTier": "${loyaltyTier}"
            }
          }
        },
        "notifications": {
          "recipient": {
            "email": "${email}",
            "locale": "${country}"
          }
        }
      }
    },
    {
      "id": "new-customer",
      "group": "customer",
      "name": "New customer",
      "description": "First order, no history",
      "fields": [
        {
          "key": "email",
          "label": "Email",
          "type": "text",
          "default": "new.person@example.com"
        },
        {
          "key": "country",
          "label": "Country",
          "type": "select",
          "options": [
            "NL",
            "GB",
            "DE",
            "US",
            "IN"
          ],
          "default": "GB"
        },
        {
          "key": "marketingOptIn",
          "label": "Marketing opt-in",
          "type": "switch",
          "default": false
        }
      ],
      "documents": {
        "orders-api": {
          "body": {
            "customer": {
              "type": "new",
              "country": "${country}",
              "marketingOptIn": "${marketingOptIn}"
            }
          }
        },
        "notifications": {
          "recipient": {
            "email": "${email}",
            "locale": "${country}"
          },
          "subscribe": "${marketingOptIn}"
        }
      }
    },
    {
      "id": "card-approved",
      "group": "payment",
      "name": "Card \u2014 approved",
      "description": "The card clears first time",
      "fields": [
        {
          "key": "cardBrand",
          "label": "Card brand",
          "type": "radio",
          "options": [
            "visa",
            "mastercard",
            "amex"
          ],
          "default": "visa"
        },
        {
          "key": "cardLast4",
          "label": "Last four digits",
          "type": "text",
          "default": "4242"
        }
      ],
      "documents": {
        "payments": {
          "method": "POST",
          "path": "/charges",
          "body": {
            "instrument": {
              "type": "card",
              "brand": "${cardBrand}",
              "last4": "${cardLast4}"
            },
            "simulate": "approved"
          }
        },
        "assertions": {
          "payment": {
            "outcome": "approved"
          }
        }
      }
    },
    {
      "id": "card-declined",
      "group": "payment",
      "name": "Card \u2014 declined",
      "description": "The issuer refuses the charge",
      "fields": [
        {
          "key": "cardBrand",
          "label": "Card brand",
          "type": "radio",
          "options": [
            "visa",
            "mastercard",
            "amex"
          ],
          "default": "visa"
        },
        {
          "key": "declineCode",
          "label": "Decline code",
          "type": "select",
          "options": [
            "expired_card",
            "insufficient_funds",
            "do_not_honour"
          ],
          "default": "expired_card"
        }
      ],
      "documents": {
        "payments": {
          "method": "POST",
          "path": "/charges",
          "body": {
            "instrument": {
              "type": "card",
              "brand": "${cardBrand}"
            },
            "simulate": "declined",
            "declineCode": "${declineCode}"
          }
        },
        "assertions": {
          "payment": {
            "outcome": "declined",
            "code": "${declineCode}"
          }
        }
      }
    },
    {
      "id": "bank-transfer",
      "group": "payment",
      "name": "Bank transfer",
      "description": "Paid out of band, settles later",
      "fields": [
        {
          "key": "bankScheme",
          "label": "Scheme",
          "type": "select",
          "options": [
            "ideal",
            "sepa",
            "faster-payments"
          ],
          "default": "ideal"
        },
        {
          "key": "settlementDelayHours",
          "label": "Settlement delay (hours)",
          "type": "range",
          "default": 24,
          "min": 0,
          "max": 72,
          "step": 6
        }
      ],
      "documents": {
        "payments": {
          "method": "POST",
          "path": "/transfers",
          "body": {
            "scheme": "${bankScheme}",
            "settlementDelayHours": "${settlementDelayHours}"
          }
        },
        "assertions": {
          "payment": {
            "outcome": "pending",
            "settlesWithinHours": "${settlementDelayHours}"
          }
        }
      }
    },
    {
      "id": "stock-reserved",
      "group": "fulfilment",
      "name": "Stock reserved",
      "description": "The warehouse holds the items",
      "fields": [
        {
          "key": "warehouse",
          "label": "Warehouse",
          "type": "select",
          "options": [
            "ams-1",
            "lon-2",
            "fra-3"
          ],
          "default": "ams-1"
        },
        {
          "key": "carrier",
          "label": "Carrier",
          "type": "select",
          "options": [
            "postnl",
            "dhl",
            "ups"
          ],
          "default": "postnl"
        },
        {
          "key": "promisedDays",
          "label": "Promised days",
          "type": "number",
          "default": 3,
          "min": 1,
          "max": 30
        }
      ],
      "documents": {
        "inventory": {
          "method": "POST",
          "path": "/reservations",
          "body": {
            "warehouse": "${warehouse}",
            "sku": "${sku}",
            "quantity": "${quantity}"
          }
        },
        "orders-api": {
          "body": {
            "fulfilment": {
              "carrier": "${carrier}",
              "promisedDays": "${promisedDays}"
            }
          }
        },
        "assertions": {
          "inventory": {
            "reserved": true,
            "warehouse": "${warehouse}"
          }
        }
      }
    },
    {
      "id": "backorder",
      "group": "fulfilment",
      "name": "Backordered",
      "description": "Nothing in stock, the order waits",
      "fields": [
        {
          "key": "warehouse",
          "label": "Warehouse",
          "type": "select",
          "options": [
            "ams-1",
            "lon-2",
            "fra-3"
          ],
          "default": "ams-1"
        },
        {
          "key": "restockDate",
          "label": "Expected restock",
          "type": "date",
          "default": "2026-10-15"
        }
      ],
      "documents": {
        "inventory": {
          "method": "POST",
          "path": "/reservations",
          "body": {
            "warehouse": "${warehouse}",
            "sku": "${sku}",
            "quantity": "${quantity}",
            "allowBackorder": true
          }
        },
        "orders-api": {
          "body": {
            "fulfilment": {
              "status": "backordered",
              "restockOn": "${restockDate}"
            }
          }
        },
        "assertions": {
          "inventory": {
            "reserved": false,
            "backordered": true
          }
        }
      }
    },
    {
      "id": "email-only",
      "group": "notification",
      "name": "Email only",
      "description": "One confirmation email",
      "fields": [
        {
          "key": "emailTemplate",
          "label": "Email template",
          "type": "text",
          "default": "order-confirmation"
        }
      ],
      "documents": {
        "notifications": {
          "send": [
            {
              "channel": "email",
              "template": "${emailTemplate}"
            }
          ]
        },
        "assertions": {
          "notifications": {
            "emails": [
              "${emailTemplate}"
            ],
            "sms": 0
          }
        }
      }
    },
    {
      "id": "email-and-sms",
      "group": "notification",
      "name": "Email and SMS",
      "description": "Confirmation by both channels",
      "fields": [
        {
          "key": "emailTemplate",
          "label": "Email template",
          "type": "text",
          "default": "order-confirmation"
        },
        {
          "key": "smsTemplate",
          "label": "SMS template",
          "type": "text",
          "default": "order-confirmation-sms"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "text",
          "default": "+31 6 1234 5678"
        }
      ],
      "documents": {
        "notifications": {
          "send": [
            {
              "channel": "email",
              "template": "${emailTemplate}"
            },
            {
              "channel": "sms",
              "template": "${smsTemplate}",
              "to": "${phone}"
            }
          ]
        },
        "assertions": {
          "notifications": {
            "emails": [
              "${emailTemplate}"
            ],
            "sms": 1
          }
        }
      }
    },
    {
      "id": "expect-success",
      "group": "expectations",
      "name": "Expect success",
      "description": "The run should finish cleanly",
      "fields": [
        {
          "key": "expectedStatus",
          "label": "Expected status",
          "type": "text",
          "default": "paid"
        },
        {
          "key": "expectedEmails",
          "label": "Emails that must arrive",
          "type": "tags",
          "default": [
            "order-confirmation"
          ],
          "help": "Enter to add each one"
        }
      ],
      "documents": {
        "assertions": {
          "outcome": "success",
          "status": "${expectedStatus}",
          "emails": "${expectedEmails}"
        }
      }
    },
    {
      "id": "expect-failure",
      "group": "expectations",
      "name": "Expect failure",
      "description": "The run should stop with an error",
      "fields": [
        {
          "key": "expectedStatus",
          "label": "Expected status",
          "type": "text",
          "default": "payment_failed"
        },
        {
          "key": "expectedError",
          "label": "Expected error code",
          "type": "select",
          "options": [
            "card_declined",
            "timeout",
            "validation_failed"
          ],
          "default": "card_declined"
        },
        {
          "key": "failureNotes",
          "label": "Why this should fail",
          "type": "textarea",
          "rows": 2,
          "default": ""
        }
      ],
      "documents": {
        "assertions": {
          "outcome": "failure",
          "status": "${expectedStatus}",
          "error": "${expectedError}",
          "notes": "${failureNotes}"
        }
      }
    }
  ]
}
